# Accept model access conditions on Hugging Face before using a read token.
HF_TOKEN=
FLUX_API_KEY=replace-with-a-long-random-secret
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-9B
# Use a commit SHA to pin model weights; a local Diffusers directory also works as MODEL_ID.
FLUX_MODEL_REVISION=main
FLUX_OFFLOAD=model
FLUX_GPU_ID=0
FLUX_DTYPE=bfloat16
FLUX_LOCAL_FILES_ONLY=false
FLUX_MAX_PIXELS=1048576
FLUX_MAX_BODY_BYTES=16777216
